{
  "name": "cli-controller-lib",
  "version": "0.1.0",
  "description": "Drive AI coding CLIs (Kiro, Cline) from Slack and a local web cockpit. Local-first, single-user, no server.",
  "bin": { "cli-controller": "bin/cli-controller.js" },
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node bin/cli-controller.js",
    "setup": "node bin/cli-controller.js setup",
    "doctor": "node bin/cli-controller.js doctor",
    "test": "node --test"
  },
  "files": [
    "bin/", "lib/", "core/",
    "slack-bridge/src/", "slack-bridge/run.sh", "slack-bridge/doctor.js", "slack-bridge/.env.example",
    "web-ui/server.js", "web-ui/public/",
    "README.md", "LICENSE"
  ],
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "dotenv": "^16.4.5",
    "slackify-markdown": "^5.0.0",
    "express": "^4.21.0"
  },
  "keywords": ["slack", "kiro", "cline", "ai", "coding-agent", "cli", "local-first", "automation"],
  "license": "MIT",
  "author": "rupeshcash",
  "repository": { "type": "git", "url": "git+https://github.com/rupeshcash/cli-controller.git" }
}
