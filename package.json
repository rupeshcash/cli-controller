{
  "name": "cli-controller-lib",
  "version": "0.1.1",
  "description": "Drive AI coding CLIs (Kiro, Cline) from Slack and a local web cockpit. Local-first, single-user, no server.",
  "bin": {
    "cli-controller": "bin/cli-controller.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/cli-controller.js",
    "setup": "node bin/cli-controller.js setup",
    "doctor": "node bin/cli-controller.js doctor",
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "files": [
    "bin/",
    "lib/",
    "core/",
    "slack-bridge/src/",
    "slack-bridge/run.sh",
    "slack-bridge/doctor.js",
    "slack-bridge/.env.example",
    "web-ui/server.js",
    "web-ui/public/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "slackify-markdown": "^5.0.0"
  },
  "keywords": [
    "slack",
    "kiro",
    "cline",
    "ai",
    "coding-agent",
    "cli",
    "local-first",
    "automation"
  ],
  "license": "MIT",
  "author": "rupeshcash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rupeshcash/cli-controller.git"
  },
  "bugs": {
    "url": "https://github.com/rupeshcash/cli-controller/issues"
  },
  "homepage": "https://github.com/rupeshcash/cli-controller#readme",
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
