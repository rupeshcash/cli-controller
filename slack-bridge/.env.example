# ── Slack tokens (REQUIRED) ────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill these in. See SETUP.md.

# Bot User OAuth Token — starts with xoxb-  (Slack app → OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# App-Level Token for Socket Mode — starts with xapp-  (Slack app → Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-REPLACE-ME

# ── Access control (REQUIRED) ──────────────────────────────────────────────
# Comma-separated Slack user IDs allowed to talk to the bot. Leave empty and the
# bot ignores EVERYONE (fail-safe). Find yours: Slack profile → ⋮ → Copy member ID (starts with U).
SLACK_ALLOWED_USER_IDS=U0XXXXXXXX

# ── Kiro settings (optional) ───────────────────────────────────────────────
KIRO_BIN=kiro-cli
# Default working directory Kiro runs in (repo you want it to operate on):
KIRO_DEFAULT_CWD=/Users/rupeshkashyap
# Model (blank = Kiro default). e.g. claude-sonnet-4.6, claude-haiku-4.5
KIRO_MODEL=
# Default agent / context profile (blank = Kiro default). See: kiro-cli agent list
KIRO_AGENT=main
# Per-run timeout in ms (default 300000 = 5 min). Set 0 for NO timeout (long autonomous runs).
KIRO_TIMEOUT_MS=300000
# Directory aliases for quick starts: name:path,comma-separated. Then: !new <alias> <task> or dir=<alias>
# Example: api:~/projects/api,web:~/projects/web
KIRO_DIR_ALIASES=
# Tools Kiro may use WITHOUT asking (headless mode can't show permission prompts):
#   fs_read       = read-only, safe default (recommended, esp. on a work laptop)
#   (empty)       = no tools; pure chat/reasoning
#   fs_read,fs_write = allow file edits
#   ALL           = full autonomy incl. running commands (DANGEROUS on a work box)
KIRO_TRUST_TOOLS=fs_read
