#!/usr/bin/env bash
# panel — one-command control for the Kiro Control Panel web UI.
# Usage:  ./panel start | stop | restart | status | open
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
PIDFILE="$DIR/panel.pid"
LOGFILE="$DIR/panel.log"
PORT="${PANEL_PORT:-1234}"

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-status}" in
  start)
    if is_running; then echo "Already running (pid $(cat "$PIDFILE")) at http://localhost:$PORT"; exit 0; fi
    cd "$DIR"
    nohup node server.js > "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 2
    if is_running; then echo "⚡ Panel started at http://localhost:$PORT (pid $(cat "$PIDFILE"))"; else echo "Failed — check $LOGFILE"; exit 1; fi
    ;;
  stop)
    if ! is_running; then echo "Not running."; exit 0; fi
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "🛑 Panel stopped."
    ;;
  restart)
    "$DIR/panel" stop; sleep 1; "$DIR/panel" start
    ;;
  status)
    if is_running; then echo "⚡ Running (pid $(cat "$PIDFILE")) at http://localhost:$PORT"; else echo "Not running."; fi
    ;;
  open)
    "$0" start 2>/dev/null
    open "http://localhost:$PORT"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|open}"
    exit 1
    ;;
esac
